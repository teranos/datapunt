{
    "name": "datapunt",
    "description": "Is a datapunt answered",
    "targetType": "executable",
    "sourcePaths": ["src"],
    "stringImportPaths": ["."],
    "dflags": ["--lowmem"],
    "extraDependencyFiles": [".ctfe/schema.json"],
    "preBuildCommands": ["./wind"],
    "configurations": [
        {
            "name": "cli",
            "targetName": "datapunt",
            "mainSourceFile": "src/app.d",
            "excludedSourceFiles": ["src/plugin/*"]
        },
        {
            "name": "plugin",
            "targetName": "qntx-datapunt-plugin",
            "targetPath": "bin",
            "mainSourceFile": "src/plugin/entry.d",
            "excludedSourceFiles": ["src/app.d", "src/node.d", "src/jsonl.d", "src/records.d"]
        }
    ]
}
